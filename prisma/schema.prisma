// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Owner {
  id                  String      @id @default(cuid())
  email               String      @unique
  passwordHash        String
  hostLanguage        String      @default("en")
  defaultGuestLanguage String     @default("en")
  fallbackLanguage    String      @default("en")
  whatsappPhoneNumberId String?    @unique
  retentionDays       Int         @default(90)
  passwordChangedAt   DateTime?
  monthlyAiBudgetCents Int        @default(1500)
  monthlyTemplateCap  Int         @default(1000)
  waTemplateCost      String      @default("0")
  budgetWarnedMonth   String?
  enquiriesEnabled    Boolean     @default(false)
  weeklySummaryEnabled Boolean   @default(true)
  lastSummaryWeek     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  apartments          Apartment[]
  templates           MessageTemplate[]
  unmatched           UnmatchedMessage[]
  optOuts             OptOut[]
  auditLogs           AuditLog[]
  usageDaily          UsageDaily[]
  leads               Lead[]
}

model Apartment {
  id               String   @id @default(cuid())
  ownerId          String
  name             String
  address          String
  checkInTime      String   // Format: "14:00"
  checkOutTime     String   // Format: "11:00"
  info             String   @default("")
  publicInfo       String   @default("")
  maxGuests        Int      @default(2)
  bedrooms         Int      @default(1)
  baseNightlyCents Int      @default(0)
  cleaningFeeCents Int      @default(0)
  minNights        Int      @default(1)
  reviewUrl        String?  // https link where guests leave a review
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner            Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  feeds            CalendarFeed[]
  bookings         Booking[]
  exportFeeds      ExportFeed[]
  rates             Rate[]
  leads            Lead[]

  @@index([ownerId])
}

model CalendarFeed {
  id         String   @id @default(cuid())
  apartmentId String
  source     String   // AIRBNB, BOOKING_COM, DIRECT
  icalUrl    String
  lastSyncAt DateTime?
  lastSuccessAt DateTime?
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  apartment  Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([apartmentId])
}

model Booking {
  id           String   @id @default(cuid())
  apartmentId  String
  externalUid  String?  // For synced bookings from iCal feeds
  source       String   // AIRBNB, BOOKING_COM, DIRECT
  status       String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  checkIn      DateTime
  checkOut     DateTime
  guestName    String?
  guestPhone   String?
  guestLanguage String? // ISO 639-1 code
  guests       Int?     // number of guests, if known
  notes        String?  // private notes for the host
  isBlock      Boolean  @default(false)  // host-blocked dates, not a guest stay
  messagesPaused Boolean @default(false)    // host paused automatic messages (used in Phase 6)
  optedInAt    DateTime?
  optedOutAt   DateTime?
  anonymisedAt DateTime?
  calendarFeedId String?
  calendarFeed CalendarFeed? @relation(fields: [calendarFeedId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apartment    Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  messages     Message[]
  scheduled    ScheduledMessage[]

  @@unique([apartmentId, externalUid])
  @@index([apartmentId])
  @@index([externalUid])
  @@index([calendarFeedId])
}

model Message {
  id                  String   @id @default(cuid())
  bookingId           String
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction           String   // INBOUND, OUTBOUND
  body                String
  author              String?  // GUEST, AI, HOST, SYSTEM
  language            String?
  escalated           Boolean  @default(false)
  resolved            Boolean  @default(false)
  hostSummary         String?
  escalationReason    String?
  urgent              Boolean  @default(false)
  hasMedia            Boolean  @default(false)
  metaMessageId       String?  @unique
  deliveryStatus      String?  // queued | sent | delivered | read | failed | undelivered | dry-run
  errorCode           Int?
  scheduledMessageId  String?  @unique
  originalBody        String?  // the host's text in her own language, when the sent text is a translation
  resolvedAt          DateTime?
  reminderSentAt      DateTime?
  feedback            String?  // GOOD, WRONG
  feedbackNote        String?  // optional, max 300 characters
  feedbackAt          DateTime?
  createdAt           DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([escalated, resolved])
}

model ScheduledMessage {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type            String   // PRE_ARRIVAL, CHECK_IN, CHECK_OUT, REVIEW_REQUEST
  sendAt          DateTime
  status          String   @default("PENDING") // PENDING, SENDING, SENT, SKIPPED, FAILED, CANCELLED
  attempts        Int      @default(0)
  claimedAt       DateTime?
  sentAt          DateTime?
  lastError       String?
  skipReason      String?
  hostSkipped     Boolean  @default(false)
  metaMessageId   String?
  language        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, sendAt])
  @@index([bookingId])
}

model MessageTemplate {
  id        String              @id @default(cuid())
  ownerId   String
  owner     Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      String              // PRE_ARRIVAL, CHECK_IN, CHECK_OUT, REVIEW_REQUEST
  body      String              // host's text, in the host's language, with {{variables}}
  enabled   Boolean             @default(true)
  translations TemplateTranslation[]
  updatedAt DateTime            @updatedAt

  @@unique([ownerId, type])
  @@index([ownerId])
}

model TemplateTranslation {
  id              String          @id @default(cuid())
  templateId      String
  template        MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  language        String
  body            String
  sourceHash      String          // hash of the host's source text this was made from
  editedByHost    Boolean         @default(false)
  approval        String          @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  contentSid      String?         // Twilio Content SID (HX...)
  rejectionReason String?
  updatedAt       DateTime        @updatedAt

  @@unique([templateId, language])
  @@index([templateId])
}

model UnmatchedMessage {
  id         String   @id @default(cuid())
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phone      String
  body       String
  hasMedia   Boolean  @default(false)
  metaMessageId  String   @unique
  receivedAt DateTime @default(now())
  repliedAt  DateTime?
  handledAt  DateTime?
  linkedBookingId String?

  @@index([ownerId, phone, receivedAt])
}

model OptOut {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phoneHash String
  createdAt DateTime @default(now())

  @@unique([ownerId, phoneHash])
  @@index([ownerId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
}

model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    String?

  @@index([job, startedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  ownerId    String?
  owner      Owner?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
}

model UsageDaily {
  id           String    @id @default(cuid())
  ownerId      String
  owner        Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  day          DateTime
  kind         String    // AI_REPLY, AI_TRANSLATE, AI_TEMPLATE, WA_TEMPLATE, WA_FREEFORM
  count        Int       @default(0)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([ownerId, day, kind])
}

model ExportFeed {
  id            String   @id @default(cuid())
  apartmentId   String
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  target        String   // AIRBNB or BOOKING_COM (ExportTarget enum in app code)
  token         String   @unique
  enabled       Boolean  @default(false)
  enabledAt     DateTime?
  confirmedAt   DateTime?
  lastFetchedAt DateTime?
  fetchCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([apartmentId, target])
}

model Rate {
  id           String   @id @default(cuid())
  apartmentId  String
  apartment    Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  nightlyCents Int
  minNights    Int?
  createdAt    DateTime @default(now())

  @@index([apartmentId, startDate, endDate])
}

model Lead {
  id                 String     @id @default(cuid())
  ownerId            String
  owner              Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phone              String
  name               String?
  status             String     @default("NEW") // NEW, QUOTED, NEEDS_HOST, BOOKED, LOST
  checkIn            DateTime?
  checkOut           DateTime?
  guests             Int?
  apartmentId        String?
  apartment          Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  quotedCents        Int?
  language           String?
  notes              String?
  bookingId          String?                       // set when converted
  convertedBookingId String?                       // Booking id when converted (for link)
  blockedAt          DateTime?                     // host blocked this number: no reply, nothing stored
  lastInboundAt      DateTime   @default(now())
  lastOutboundAt     DateTime?
  followUpSentAt     DateTime?                     // Phase 12: when follow-up message was sent
  hostSummary        String?                       // for the host, in the host's language
  needsHostReason    String?
  urgent             Boolean    @default(false)
  createdAt          DateTime   @default(now())
  messages           LeadMessage[]

  @@unique([ownerId, phone])
  @@index([ownerId, status, lastInboundAt])
}

model LeadMessage {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction        String    // INBOUND, OUTBOUND
  author           String?   // GUEST, AI, HOST, SYSTEM
  body             String
  originalBody     String?   // the host's own-language text when the sent text is a translation
  language         String?
  hasMedia         Boolean   @default(false)
  twilioSid        String?   @unique
  deliveryStatus   String?
  errorCode        Int?
  escalated        Boolean   @default(false)
  urgent           Boolean   @default(false)
  escalationReason String?
  hostSummary      String?
  resolved         Boolean   @default(false)
  resolvedAt       DateTime?
  reminderSentAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([leadId, createdAt])
  @@index([escalated, resolved])
}