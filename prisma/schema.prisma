// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Owner {
  id                  String      @id @default(cuid())
  email               String      @unique
  passwordHash        String
  hostLanguage        String      @default("en")
  defaultGuestLanguage String     @default("en")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  apartments          Apartment[]
}

model Apartment {
  id               String   @id @default(cuid())
  ownerId          String
  name             String
  address          String
  checkInTime      String   // Format: "14:00"
  checkOutTime     String   // Format: "11:00"
  info             String   @default("")
  publicInfo       String   @default("")
  maxGuests        Int      @default(2)
  bedrooms         Int      @default(1)
  baseNightlyCents Int      @default(0)
  cleaningFeeCents Int      @default(0)
  minNights        Int      @default(1)
  icalExportToken  String   @unique @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  feeds            CalendarFeed[]
  bookings         Booking[]

  @@index([ownerId])
}

model CalendarFeed {
  id         String   @id @default(cuid())
  apartmentId String
  source     String   // AIRBNB, BOOKING_COM, DIRECT
  icalUrl    String
  lastSyncAt DateTime?
  lastSuccessAt DateTime?
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  apartment  Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([apartmentId])
}

model Booking {
  id           String   @id @default(cuid())
  apartmentId  String
  externalUid  String?  // For synced bookings from iCal feeds
  source       String   // AIRBNB, BOOKING_COM, DIRECT
  status       String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  checkIn      DateTime
  checkOut     DateTime
  guestName    String?
  guestPhone   String?
  guestLanguage String? // ISO 639-1 code
  isBlock      Boolean  @default(false)  // host-blocked dates, not a guest stay
  calendarFeedId String?
  calendarFeed CalendarFeed? @relation(fields: [calendarFeedId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apartment    Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, externalUid])
  @@index([apartmentId])
  @@index([externalUid])
  @@index([calendarFeedId])
}