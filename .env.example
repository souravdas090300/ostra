# Database
# Local dev: SQLite (file:./dev.db)
# Production: PostgreSQL on Railway (use Railway variable reference: {{postgres.DATABASE_URL}})
DATABASE_URL=file:./dev.db

# App
APP_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
CRON_SECRET=
TZ=UTC
NODE_ENV=development

# Seed (development and first production owner only)
SEED_OWNER_EMAIL=host@example.com
SEED_OWNER_PASSWORD=
SEED_ALLOW_PRODUCTION=false

# WhatsApp / Twilio
WHATSAPP_MODE=dry-run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Anthropic AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Safety caps
MAX_TEMPLATE_SENDS_PER_DAY=1000
MAX_AI_REPLIES_PER_DAY=100
INBOUND_DEBOUNCE_MS=1000

# Notifications (Resend)
RESEND_API_KEY=
NOTIFY_FROM=
OPERATOR_EMAIL=

# Security & Monitoring
DATA_PEPPER=
TRUST_PROXY=1
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# AI Cost Tracking
AI_INPUT_EUR_PER_MTOK=0.003
AI_OUTPUT_EUR_PER_MTOK=0.015

# Feature Flags
ASSISTANT_ENABLED=true
AUTOMATIC_MESSAGES_ENABLED=true

# Heartbeat Monitoring
PING_URL_LEAD_FOLLOW_UPS=
PING_URL_WEEKLY_SUMMARY=
BACKUP_PING_URL=

# Backup Service (S3-compatible)
AGE_PUBLIC_KEY=
BACKUP_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Export Timing
EXPORT_STALE_AFTER_HOURS=48

# Lead Follow-up Timing
LEAD_FOLLOW_UP_AFTER_HOURS=16

# Testing
LLM_FAKE=false
RUN_LLM_EVALS=false
