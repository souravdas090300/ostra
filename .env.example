# Environment Setup
# Copy the appropriate environment file to .env:
# - Local development: cp .env.dev .env
# - Production: cp .env.prod .env (then fill in actual values)

# Database
# Local dev: SQLite (file:./dev.db)
# Production: Neon PostgreSQL (get from https://console.neon.tech)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp (Twilio)
WHATSAPP_MODE=dry-run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
MAX_TEMPLATE_SENDS_PER_DAY=100
INBOUND_DEBOUNCE_MS=3000
MAX_AI_REPLIES_PER_DAY=300

# Cron security
CRON_SECRET=

# App URL
APP_URL=http://localhost:3000

# Email notifications (Resend, optional)
RESEND_API_KEY=
NOTIFY_FROM=

# Seed data (local only)
SEED_EMAIL=admin@ostra.test
SEED_PASSWORD=password123
