# Environment Setup
# Copy the appropriate environment file to .env:
# - Local development: cp .env.dev .env
# - Production: cp .env.prod .env (then fill in actual values)

# Database
# Local dev: SQLite (file:./dev.db)
# Production: Neon PostgreSQL (get from https://console.neon.tech)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cron security
CRON_SECRET=

# App URL
APP_URL=

# Seed data (local only)
SEED_EMAIL=
SEED_PASSWORD=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

