# Environment Setup
# Copy the appropriate environment file to .env:
# - Local development: cp .env.dev .env
# - Production: cp .env.prod .env (then fill in actual values)

# Database
# Local dev: SQLite (file:./dev.db)
# Production: Neon PostgreSQL (get from https://console.neon.tech)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp (Twilio)
WHATSAPP_MODE=dry-run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
MAX_TEMPLATE_SENDS_PER_DAY=100
INBOUND_DEBOUNCE_MS=3000
MAX_AI_REPLIES_PER_DAY=300

# Cron security
CRON_SECRET=

# App URL
APP_URL=http://localhost:3000

# Email notifications (Resend, optional)
RESEND_API_KEY=
NOTIFY_FROM=

# Seed data (local only)
SEED_EMAIL=admin@ostra.test
SEED_PASSWORD=password123

# Phase 9: Production Hardening
DATA_PEPPER=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
OPERATOR_EMAIL=
TRUST_PROXY=1
ASSISTANT_ENABLED=true
AUTOMATIC_MESSAGES_ENABLED=true
AI_INPUT_EUR_PER_MTOK=
AI_OUTPUT_EUR_PER_MTOK=
PING_URL_SYNC_CALENDARS=
PING_URL_SEND_SCHEDULED=
PING_URL_SYNC_TEMPLATES=
PING_URL_ESCALATION_REMINDERS=
PING_URL_RETENTION=
PING_URL_SELF_CHECK=
PING_URL_INBOUND_RECOVERY=
PING_URL_BACKUP=
BACKUP_PING_URL=
