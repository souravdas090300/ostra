{
  "name": "ostra",
  "version": "1.0.0",
  "description": "See OSTRA_PLAN.md for the build plan.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "env:dev": "cp .env.dev .env && node scripts/switch-env.js dev",
    "env:prod": "cp .env.prod .env && node scripts/switch-env.js prod",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^11.8.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "libphonenumber-js": "^1.13.15",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.32",
    "node-ical": "^0.27.3",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twilio": "^6.2.0",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
