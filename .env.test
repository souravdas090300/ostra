# Test database - PostgreSQL via docker-compose
DATABASE_URL=postgresql://ostra:ostra_test_password@127.0.0.1:5436/ostra_test

# App settings for tests
APP_URL=http://localhost:3000
AUTH_SECRET=test-secret-key-for-testing-only
AUTH_TRUST_HOST=true
CRON_SECRET=test-cron-secret
TZ=UTC
NODE_ENV=test

# Disable external services in tests
WHATSAPP_MODE=dry-run

# --- AI CONFIGURATION ---
# We are using Gemini for testing. Put your AIza... key here.
GEMINI_API_KEY=your_gemini_api_key_here

# AI pricing for tests (Using Gemini 1.5 Flash pricing as an estimate: $0.075 / $0.30 per 1M tokens)
AI_INPUT_EUR_PER_MTOK=0.07
AI_OUTPUT_EUR_PER_MTOK=0.28

# Feature flags
ASSISTANT_ENABLED=true
AUTOMATIC_MESSAGES_ENABLED=true

# Testing flags
LLM_FAKE=true
RUN_LLM_EVALS=false