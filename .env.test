# Test database - PostgreSQL via docker-compose
DATABASE_URL=postgresql://ostra:ostra_test_password@127.0.0.1:5434/ostra_test

# App settings for tests
APP_URL=http://localhost:3000
AUTH_SECRET=test-secret-key-for-testing-only
AUTH_TRUST_HOST=true
CRON_SECRET=test-cron-secret
TZ=UTC
NODE_ENV=test

# Disable external services in tests
WHATSAPP_MODE=dry-run
ANTHROPIC_API_KEY=
MAX_TEMPLATE_SENDS_PER_DAY=1000
MAX_AI_REPLIES_PER_DAY=100
INBOUND_DEBOUNCE_MS=1000

# AI pricing for tests
AI_INPUT_EUR_PER_MTOK=0.003
AI_OUTPUT_EUR_PER_MTOK=0.015

# Feature flags
ASSISTANT_ENABLED=true
AUTOMATIC_MESSAGES_ENABLED=true

# Testing flags
LLM_FAKE=true
RUN_LLM_EVALS=false
